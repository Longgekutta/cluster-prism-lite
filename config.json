{
  "api_base": "https://api.deepseek.com/v1",
  "models": {
    "FLASH": "deepseek-chat",
    "ELITE": "deepseek-reasoner"
  },
  "fleet": [
    {"model_id": "deepseek-flash", "source": "official", "tier": "FLASH", "elo": 100.0,
     "adapter": {"kind": "openai", "api_base": "https://api.deepseek.com/v1"}},
    {"model_id": "deepseek-reasoner", "source": "official", "tier": "ELITE", "elo": 130.0,
     "adapter": {"kind": "openai", "api_base": "https://api.deepseek.com/v1"}},
    {"model_id": "gpt-web-bridge", "source": "bridge", "tier": "ELITE", "elo": 125.0,
     "adapter": {"kind": "bridge", "endpoint": "http://127.0.0.1:8005/v1/chat/completions"}},
    {"model_id": "claude-web-bridge", "source": "bridge", "tier": "ELITE", "elo": 125.0,
     "adapter": {"kind": "bridge", "endpoint": "http://127.0.0.1:8006/v1/chat/completions"}},
    {"model_id": "echo-test", "source": "test", "tier": "FLASH", "elo": 10.0,
     "adapter": {"kind": "echo"}}
  ],
  "cron": {
    "expr": "*/30 * * * *",
    "task": "health probe"
  },
  "telegram_enabled": true,
  "notify": {
    "ntfy_topic": "",
    "endpoint": "https://ntfy.sh"
  },
  "cache": {
    "ttl_seconds": 3600,
    "prefix_alignment_baseline": 2048,
    "deterministic_temp_max": 0.25
  }
}
