{
  "api_base": "https://api.deepseek.com/v1",
  "models": {
    "FLASH": "deepseek-chat",
    "ELITE": "deepseek-reasoner"
  },
  "fleet": [
    {
      "model_id": "deepseek-flash",
      "source": "official",
      "tier": "FLASH",
      "elo": 100.0,
      "adapter": {
        "kind": "openai",
        "api_base": "https://api.deepseek.com/v1"
      }
    },
    {
      "model_id": "deepseek-reasoner",
      "source": "official",
      "tier": "ELITE",
      "elo": 130.0,
      "adapter": {
        "kind": "openai",
        "api_base": "https://api.deepseek.com/v1"
      }
    },
    {
      "model_id": "gpt-web-bridge",
      "source": "bridge",
      "tier": "ELITE",
      "elo": 125.0,
      "adapter": {
        "kind": "bridge",
        "endpoint": "http://127.0.0.1:8005/v1/chat/completions"
      }
    },
    {
      "model_id": "claude-web-bridge",
      "source": "bridge",
      "tier": "ELITE",
      "elo": 125.0,
      "adapter": {
        "kind": "bridge",
        "endpoint": "http://127.0.0.1:8006/v1/chat/completions"
      }
    },
    {
      "model_id": "echo-test",
      "source": "test",
      "tier": "FLASH",
      "elo": 10.0,
      "adapter": {
        "kind": "echo"
      }
    }
  ],
  "cron": {
    "expr": "*/30 * * * *",
    "task": "health probe"
  },
  "telegram_enabled": true,
  "notify": {
    "ntfy_topic": "",
    "endpoint": "https://ntfy.sh"
  },
  "cache": {
    "ttl_seconds": 3600,
    "prefix_alignment_baseline": 2048,
    "deterministic_temp_max": 0.25
  },
  "platforms": [
    {
      "name": "senseaudio",
      "api_base": "https://api.senseaudio.cn",
      "key_env": "SENSEAUDIO_API_KEY"
    },
    {
      "name": "deepseek",
      "api_base": "https://api.deepseek.com/v1",
      "key_env": "DEEPSEEK_API_KEY"
    }
  ],
  "leaderboard": {
    "sources": [
      "openrouter",
      "models_dev"
    ],
    "ttl_seconds": 3600,
    "note": "lmarena/huggingface 被墙 → openrouter artificial_analysis 指数 + models.dev 元数据 + 静态快照兜底"
  },
  "workers": [
    {
      "name": "claude-code",
      "command": ["/opt/node/bin/claude-agent-acp"],
      "env_key": "ANTHROPIC_API_KEY",
      "cwd": "/root/10.2",
      "timeout_s": 300,
      "note": "执行工兵：经 claude-agent-acp 桥（官方 Zed 生态适配器）以标准 ACP v1 驱动 Claude Code；泛化：换 command+env_key 即接任何 ACP 兼容 agent"
    }
  ]
}